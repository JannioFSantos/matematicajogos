const choiceScreen = document.getElementById('choiceScreen');
const gameScreen = document.getElementById('gameScreen');
const gameGrid = document.getElementById('gameGrid');
const gameCard = document.querySelectorAll('.game-card');
const gameRenderer = document.getElementById('gameRenderer');
const gameTitle = document.getElementById('gameTitle');
const gameScreenLabel = document.getElementById('gameScreenLabel');
const startButton = document.getElementById('startButton');
const backButton = document.getElementById('backButton');
const scoreValue = document.getElementById('scoreValue');

let currentGame = 'quiz';
let currentQuestion = 0;
let score = 0;

function openGame(gameKey) {
  currentGame = gameKey;
  currentQuestion = 0;
  score = 0;
  choiceScreen.classList.remove('active');
  gameScreen.classList.add('active');
  scoreValue.textContent = score;
  renderGame(games[gameKey]);
}

function backToMenu() {
  gameScreen.classList.remove('active');
  choiceScreen.classList.add('active');
}

function renderGame(game) {
  const data = game.questions[currentQuestion];
  gameTitle.textContent = game.title;
  gameScreenLabel.textContent = game.label;
  const playerOptions = data.options.map((option, index) => {
    return `<button class="answer-button" data-index="${index}" data-answer="${option}">${option}</button>`;
  }).join('');

  gameRenderer.innerHTML = `
    <div class="question-card">
      <div class="question-top">
        <span class="question-number">Questão ${currentQuestion + 1}/${game.questions.length}</span>
        <span class="question-level">${data.level}</span>
      </div>
      <div class="question-text">${data.question}</div>
      <div class="answer-grid">
        ${playerOptions}
      </div>
      <div class="question-actions">
        <span class="question-message" id="message">Escolha a resposta</span>
        <button class="btn next-button" id="nextButton" disabled>Próxima</button>
      </div>
    </div>
  `;

  const buttons = Array.from(document.querySelectorAll('.answer-button'));
  buttons.forEach((button) => {
    button.addEventListener('click', () => handleAnswer(button, data, game));
  });
}

function handleAnswer(button, data, game) {
  const allButtons = Array.from(document.querySelectorAll('.answer-button'));
  const selected = button.dataset.answer;
  const message = document.getElementById('message');
  const nextButton = document.getElementById('nextButton');

  allButtons.forEach((option) => {
    option.disabled = true;
    if (option.dataset.answer === data.answer) {
      option.classList.add('correct');
    }
  });

  if (selected === data.answer) {
    button.classList.add('correct');
    score += 10;
    scoreValue.textContent = score;
    message.textContent = 'Parabéns! Você acertou!';
  } else {
    button.classList.add('wrong');
    message.textContent = 'Quase! ' + data.explanation;
  }

  nextButton.disabled = false;
  nextButton.textContent = currentQuestion < game.questions.length - 1 ? 'Próxima' : 'Finalizar';
  nextButton.onclick = () => {
    if (currentQuestion < game.questions.length - 1) {
      currentQuestion++;
      renderGame(game);
    } else {
      finishGame(game);
    }
  };
}

function finishGame(game) {
  const finalGrade = Math.min(100, Math.round((score / (game.questions.length * 10)) * 100));

  gameRenderer.innerHTML = `
    <div class="correct-card">
      <h3>Missão concluída!</h3>
      <p>Você concluiu o jogo <strong>${game.title}</strong> com <strong>${score}</strong> pontos.</p>
      <p>Seu aproveitamento foi <strong>${finalGrade}%</strong>.</p>
      <div class="question-actions">
        <span class="question-message">Continue explorando!</span>
        <button class="btn primary" id="restartButton">Jogar de Novo</button>
      </div>
    </div>
  `;

  const restartButton = document.getElementById('restartButton');
  restartButton.addEventListener('click', () => {
    backToMenu();
  });
}

gameGrid.addEventListener('click', (event) => {
  const card = event.target.closest('.game-card');
  if (!card) {
    return;
  }
  const key = card.dataset.game;
  openGame(key);
});

startButton.addEventListener('click', () => {
  openGame('quiz');
});

backButton.addEventListener('click', () => {
  backToMenu();
});
